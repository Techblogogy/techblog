---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Trace from '../../components/Trace.astro';
import { allPosts } from '../../lib/posts';
import { formatDate, readingMinutes } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], series: posts.filter((p) => post.data.series && p.data.series === post.data.series).reverse() },
  }));
}
const { post, newer, older, series } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, tags } = post.data;
---
<Base title={title} description={description}>
  <article class="wrap">
    <header>
      <p class="meta muted">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span>{readingMinutes(post.body)} min read</span>
      </p>
      <h1 class="display">{title}</h1>
      <p class="dek">{description}</p>
      <Trace slug={post.id} width={640} height={36} />
    </header>
    {series.length > 1 && (
      <nav class="series" aria-label="Series">
        <p>Part of <strong>{post.data.series}</strong>:</p>
        <ol>
          {series.map((p) => (
            <li>{p.id === post.id ? <span aria-current="page">{p.data.title}</span> : <a href={`/posts/${p.id}/`}>{p.data.title}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    <div class="prose">
      <Content />
    </div>
    <footer>
      {tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((t) => <li><a href={`/tags/${t}/`}>{t}</a></li>)}
        </ul>
      )}
      <nav class="pager" aria-label="More posts">
        {older ? <a href={`/posts/${older.id}/`}><span class="muted">Older</span>{older.data.title}</a> : <span />}
        {newer && <a class="newer" href={`/posts/${newer.id}/`}><span class="muted">Newer</span>{newer.data.title}</a>}
      </nav>
    </footer>
  </article>
</Base>
<style>
  header { padding: clamp(1.5rem, 6vw, 3.5rem) 0 1.5rem; }
  .meta { display: flex; gap: 1rem; font-size: 0.9rem; margin: 0 0 0.8rem; }
  h1 { font-size: clamp(2.3rem, 7vw, 3.8rem); margin: 0 0 1rem; }
  .dek { font-size: 1.2rem; color: var(--ink-soft); margin: 0 0 1.5rem; }
  .series { background: var(--panel); border: 1px solid var(--rule); border-radius: 8px; padding: 0.9rem 1.1rem; margin: 0 0 2rem; font-size: 0.95rem; }
  .series p { margin: 0 0 0.3rem; }
  .series ol { margin: 0; padding-left: 1.3rem; }
  .series [aria-current] { font-weight: 600; }
  footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .tags { list-style: none; padding: 0; margin: 0 0 1.8rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tags a { font-size: 0.85rem; text-decoration: none; border: 1px solid var(--rule); border-radius: 999px; padding: 0.15rem 0.7rem; color: var(--ink-soft); }
  .tags a:hover { border-color: var(--anodized); color: var(--anodized); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .pager a { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); font-weight: 600; line-height: 1.3; }
  .pager a span { font-weight: 400; font-size: 0.85rem; margin-bottom: 0.2rem; }
  .pager .newer { text-align: right; }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } .pager .newer { text-align: left; } }
</style>
