---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { allPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await allPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`Posts tagged ${tag}`}>
  <div class="wrap wrap--wide">
    <h1 class="display">{tag}</h1>
    <p class="muted">{posts.length} {posts.length === 1 ? 'post' : 'posts'}. <a href="/">See everything</a></p>
    <PostList posts={posts} />
  </div>
</Base>
<style>
  h1 { font-size: clamp(2.5rem, 8vw, 4.5rem); margin: 2rem 0 0.5rem; }
  p { margin-bottom: 2rem; }
</style>
